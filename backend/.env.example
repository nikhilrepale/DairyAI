# Local: SQLite. Hosting: paste your own Neon Postgres connection string (with sslmode=require).
DATABASE_URL=sqlite:///./dairyai.db
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Try Ollama locally when Gemini is unavailable or errors. Install Ollama and pull this vision model first.
AI_FALLBACK_PROVIDERS=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_CLASSIFICATION_TIMEOUT=180
OLLAMA_EXTRACTION_TIMEOUT=300
AI_EXTRACTION_TIMEOUT=90
AI_CLASSIFICATION_TIMEOUT=90
# For fully-local LLM: set AI_PROVIDER=ollama, install a vision-capable model,
# and configure OLLAMA_MODEL. Auto document detection works with both providers.
AI_CONFIDENCE_THRESHOLD=0.70
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ACCESS_TOKEN_HOURS=12
CORS_ORIGINS=*
WHATSAPP_MODE=click_to_chat
# For production photos, use a PRIVATE S3-compatible bucket (Neon Object Storage or R2).
SCAN_IMAGE_STORAGE=database
# SCAN_IMAGE_STORAGE=s3
# S3_BUCKET=your-private-bucket
# S3_ENDPOINT_URL=https://your-storage-endpoint
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# REQUIRED before saving bank details or generating payment files.
# Generate ONCE and back up securely: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never rotate without decrypting/re-encrypting existing bank records.
BANK_DATA_KEY=
